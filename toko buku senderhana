def cetak_struk(total, bayar, kembali, keranjang, nama, now):
    lebar = 40
    nama_file = f"struk_{nama}_{now.replace(':','-')}.txt"

    def tengah(teks):
        return teks.center(lebar)

    with open(nama_file, "w", encoding="utf-8") as f:
        f.write(tengah("TOKO BUKU TOUR DE FORCE") + "\n")
        f.write(tengah("Jl. Pendidikan No. 1") + "\n")
        f.write(tengah("Telp: 0834567890") + "\n")
        f.write("=" * lebar + "\n")

        f.write(f"Nama   : {nama}\n")
        f.write(f"Tanggal: {now}\n")
        f.write("-" * lebar + "\n")

        for item in keranjang:
            nama_buku = item["judul"][:20]
            qty = item["qty"]
            harga = item["harga"]
            subtotal = harga * qty

            f.write(f"{nama_buku}\n")
            f.write(f"  {qty} x {harga:<10} {subtotal:>10}\n")

        f.write("-" * lebar + "\n")
        f.write(f"{'TOTAL':<20}{total:>20}\n")
        f.write(f"{'TUNAI':<20}{bayar:>20}\n")
        f.write(f"{'KEMBALI':<20}{kembali:>20}\n")
        f.write("=" * lebar + "\n")

        f.write(tengah("TERIMA KASIH") + "\n")
        f.write(tengah("SELAMAT MEMBACA 📚") + "\n")

    print(f"🖨️ Struk kasir tersimpan: {nama_file}")

main()
